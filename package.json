{
  "name": "ai-first-dev-consult-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "pnpm -r --filter \"./apps/*\" test",
    "clean": "pnpm -r --parallel exec rm -rf dist && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
