# ============================================
# Environment Variable Documentation
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked with (*) are required for production.

# --- Database ---
POSTGRES_DB=convoy
POSTGRES_USER=convoy
POSTGRES_PASSWORD=change-me (*)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://convoy:change-me@postgres:5432/convoy (*)

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-string (*)

# --- Payment ---
STRIPE_SECRET_KEY=sk_test_... (*)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI Engine ---
OPENAI_API_KEY=sk-... (*)
OPENAI_MODEL=gpt-4o

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AI_URL=http://localhost:3001

# --- Server Ports ---
API_PORT=3000
AI_ENGINE_PORT=3001
WEB_PORT=3002
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Node Environment ---
NODE_ENV=development